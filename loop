total_chores = 5
original_count = total_chores
print("You have", original_count, "chores to finish today.\n")

completed_count = 0
chore_num = 1

while chore_num <= total_chores:
    if chore_num == 1: next_chore = "Make your bed."
    elif chore_num == 2: next_chore = "Feed the sparrows."
    elif chore_num == 3: next_chore = "Do the dishes."
    elif chore_num == 4: next_chore = "Cook breakfast."
    else: next_chore = "Take out the trash."

    answer = input("Have you finished " + next_chore + " (yes/no)? ")

    if answer == "yes":
        completed_count += 1
        chore_num += 1
        print("Great job! Chore completed.")
    else:
        print("OK! Finish it and check again.")

    print("Remaining chores:", original_count - completed_count)
    print()

print("======You have finished all chores!======")
print("Great job!")
