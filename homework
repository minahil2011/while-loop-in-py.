# POWER CALCULATOR
print("=== Power Calculator ===")

# Step 1: ask the two questions
base = int(input("Enter the base number: "))
exponent = int(input("Enter the power (exponent): "))

# Step 2: the running total
result = 1

# Step 3 + 4: the loop that multiplies
for i in range(1, exponent + 1):
    result = result * base
    print("Step", i, ": result =", result)

# Step 5: the answer
print("\nAnswer:", base, "to the power", exponent, "=", result)
